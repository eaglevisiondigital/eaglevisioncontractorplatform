+ 'portalRls',(select relrowsecurity from pg_class where oid='public.portal_identities'::regclass),
+ 'functions',(select jsonb_agg(jsonb_build_object('name',p.proname,'owner',o.rolname,'ownerLogin',o.rolcanlogin,'ownerSuper',o.rolsuper,'ownerBypass',o.rolbypassrls,'definer',p.prosecdef,'volatility',p.provolatile::text,'language',l.lanname,'config',p.proconfig,'args',p.pronargs,'result',format_type(p.prorettype,null),'bodyHash',encode(sha256(convert_to(p.prosrc,'UTF8')),'hex'),'directExecute',exists(select 1 from aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) a where a.grantee=r.oid and a.privilege_type='EXECUTE' and not a.is_grantable),'publicExecute',exists(select 1 from aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) a where a.grantee=0 and a.privilege_type='EXECUTE'),'grantOption',exists(select 1 from aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) a where a.grantee=r.oid and a.is_grantable)) order by p.proname) from pg_proc p join pg_namespace n on n.oid=p.pronamespace join pg_roles o on o.oid=p.proowner join pg_language l on l.oid=p.prolang where n.nspname='private' and p.proname in('commercial_customer_invoice_authorize','commercial_customer_invoice_read_issued'))
