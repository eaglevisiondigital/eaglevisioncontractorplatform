+  expect(f.calls).toEqual({ auth: 6, session: 6, mapping: 3, source: 2 });
+  const reopened = await f.load(f.viewer, signal());
+  expect(reopened.invoice).toEqual(result.invoice);
+  expect(JSON.stringify(result)).not.toMatch(
