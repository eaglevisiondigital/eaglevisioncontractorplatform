diff --git a/tests/commercial-invoice-close-idempotency.test.ts b/tests/commercial-invoice-close-idempotency.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..685d8e2f5df56b9c7b7971b0dcf587745c43ce2b
--- /dev/null
+++ b/tests/commercial-invoice-close-idempotency.test.ts
@@ -0,0 +1,346 @@
+import { randomUUID } from 'node:crypto';
+import { setImmediate } from 'node:timers/promises';
+import { expect, it, vi } from 'vitest';
+import type { GatewaySql } from '../server/payments/postgres-store';
+import type { DisposableInvoiceBinding } from '../proposals/commercial-invoice-connection/connection';
+
+const unavailable = 'Disposable invoice connection unavailable';
+
+function cleanupGate() {
+  let finish!: (result: 'verified' | 'unconfirmed') => void;
+  let start!: () => void;
+  const result = new Promise<'verified' | 'unconfirmed'>((resolve) => {
+    finish = resolve;
+  });
+  const started = new Promise<void>((resolve) => {
+    start = resolve;
+  });
+  return { result, started, start, finish };
+}
+
+function observeClose(close: Promise<void>) {
+  let state: 'pending' | 'fulfilled' | 'rejected' = 'pending';
+  const result = close.then(
+    () => (state = 'fulfilled'),
+    () => (state = 'rejected'),
+  );
+  return { state: () => state, result };
+}
+
+// Reset the module before each fixture because unknown cleanup permanently
+// quarantines its current instance. All imports and source checks remain real.
+async function fixture(cleanup?: ReturnType<typeof cleanupGate>) {
+  vi.resetModules();
+  const { CustomerBrokerAuth } = await import('../server/customer/broker-auth');
+  const { prepareDisposableInvoiceConnection: prepare } =
+    await import('../proposals/commercial-invoice-connection/connection');
+  const organizationId = randomUUID();
+  const actor = randomUUID();
+  const session = randomUUID();
+  const command = randomUUID();
+  const requestHash = 'b'.repeat(64);
+  const now = Math.floor(Date.now() / 1000);
+  const config = {
+    url: 'https://abcdefghijklmnopqrst.supabase.co',
+    publishableKey: 'sb_publishable_fictional_only',
+  };
+  const claims = {
+    sub: actor,
+    session_id: session,
+    aal: 'aal2',
+    exp: now + 3600,
+    iat: now,
+    iss: config.url + '/auth/v1',
+    aud: 'authenticated',
+    role: 'authenticated',
+  };
+  const bearer = `e30.${Buffer.from(JSON.stringify(claims)).toString('base64url')}.fictional`;
+  const target = {
+    organizationId,
+    invoiceId: randomUUID(),
+    customerId: randomUUID(),
+    locationId: null,
+    sourceVersionId: randomUUID(),
+    revision: 1,
+    sourceHash: 'a'.repeat(64),
+  };
+  const binding: DisposableInvoiceBinding = {
+    organizationId,
+    target,
+    workload: 'issue',
+    numbering: 'FICTIONAL_FULL_UUID_ONLY',
+  };
+  const login = 'propel_invoice_connection_test_issue_login';
+  const scope = {
+    database: 'ev_test_' + randomUUID().replaceAll('-', ''),
+    pid: 100,
+    backend_start: '2026-11-14 00:00:00+00',
+    login,
+    current_role: login,
+  };
+  let connectionClaims = '';
+  let active = true;
+  let attempts = 0;
+  let acquired = 0;
+  let queryCalls = 0;
+  let cleanupState = 'not started';
+  const writes: unknown[] = [];
+  const receiptReads: unknown[] = [];
+  const evidence = {
+    ...target,
+    state: 'issued',
+    paymentState: 'unverified',
+    number: 'INV-' + target.invoiceId.replaceAll('-', ''),
+    title: 'Fictional invoice',
+    currency: 'USD',
+    amountMinor: 1100,
+    issuedAt: '2026-11-14T00:00:00.000000Z',
+    receipt: { commandId: command, actorId: actor, requestHash },
+  };
+  const sql: GatewaySql = {
+    async query<T extends Record<string, unknown>>(
+      text: string,
+      params?: unknown[],
+    ) {
+      queryCalls++;
+      let row: Record<string, unknown>;
+      if (text.includes('pg_roles')) {
+        row = {
+          rolsuper: false,
+          rolbypassrls: false,
+          rolcreatedb: false,
+          rolcreaterole: false,
+          rolreplication: false,
+          memberships: 1,
+          permitted: true,
+          login_inherit: true,
+          current_name: login,
+          runtime_name: 'propel_invoice_connection_test_issue_runtime',
+          runtime_super: false,
+          runtime_bypass: false,
+          runtime_createdb: false,
+          runtime_createrole: false,
+          runtime_replication: false,
+          runtime_login: false,
+          runtime_memberships: 0,
+        };
+      } else if (text.includes('pg_stat_activity')) {
+        row = text.includes('request.jwt.claims')
+          ? { ...scope, claims: connectionClaims }
+          : scope;
+      } else if (text.includes('set_config')) {
+        connectionClaims = String(params?.[0]);
+        row = {};
+      } else if (text.includes(' request_hash')) {
+        row = { request_hash: requestHash };
+      } else if (text.includes('private.commercial_invoice_issue(')) {
+        writes.push(params?.[2]);
+        throw Error('Fictional original issuance acknowledgment missing');
+      } else if (text.includes('private.commercial_invoice_issued_read(')) {
+        receiptReads.push(params?.[2]);
+        return {
+          rows:
+            params?.[2] === command && writes.includes(command)
+              ? [{ result: evidence } as unknown as T]
+              : [],
+        };
+      } else {
+        throw Error('Unexpected query in fictional invoice fixture');
+      }
+      return { rows: [row as T] };
+    },
+  };
+  const auth = new CustomerBrokerAuth(config, async (input) => {
+    const path = new URL(String(input)).pathname;
+    if (path === '/auth/v1/user') return Response.json({ id: actor });
+    if (path === '/rest/v1/rpc/customer_session_status')
+      return Response.json({ user_id: actor, session_id: session, active });
+    throw Error('Unexpected path in fictional Auth fixture');
+  });
+  const ports = {
+    auth,
+    bearer,
+    async acquire() {
+      acquired++;
+      return {
+        sql,
+        async destroy() {
+          attempts++;
+          cleanupState = 'pending';
+          cleanup?.start();
+          cleanupState = cleanup ? await cleanup.result : 'verified';
+          if (cleanupState === 'unconfirmed')
+            throw Error('Fictional cleanup acknowledgment missing');
+        },
+      };
+    },
+  };
+  const open = () => prepare(ports, binding, true);
+  const handle = await open();
+  if (!handle?.issuer) throw Error('Fictional invoice handle unavailable');
+  return {
+    close: handle.close,
+    issuer: handle.issuer,
+    identity: { organizationId, invoiceId: target.invoiceId, command },
+    writes,
+    receiptReads,
+    cleanup: () => ({ attempts, state: cleanupState }),
+    calls: () => ({ acquired, queryCalls }),
+    open,
+    withdraw: () => {
+      active = false;
+    },
+  };
+}
+
+it('keeps verified cleanup idempotently closed', async () => {
+  const f = await fixture();
+  await expect(f.close()).resolves.toBeUndefined();
+  await expect(f.close()).resolves.toBeUndefined();
+  expect(f.cleanup()).toEqual({ attempts: 1, state: 'verified' });
+  expect(f.writes).toEqual([]);
+});
+
+it('keeps repeated close rejected after unresolved cleanup on the original operation', async () => {
+  const gate = cleanupGate();
+  const f = await fixture(gate);
+  const { command } = f.identity;
+  await expect(f.issuer.issue(command)).rejects.toThrow('UNKNOWN');
+  const first = observeClose(f.close());
+  await gate.started;
+  gate.finish('unconfirmed');
+  const initialClose = await first.result;
+  const repeatedClose = await observeClose(f.close()).result;
+  await expect(f.open()).rejects.toThrow(unavailable);
+  await expect(f.issuer.issue(command)).rejects.toThrow(unavailable);
+  await expect(f.issuer.issue(randomUUID())).rejects.toThrow(unavailable);
+  expect({
+    initialClose,
+    repeatedClose,
+    cleanup: f.cleanup(),
+    originalCommands: f.writes,
+    financialStatus: f.issuer.status(),
+    acquisitions: f.calls().acquired,
+  }).toEqual({
+    initialClose: 'rejected',
+    repeatedClose: 'rejected',
+    cleanup: { attempts: 1, state: 'unconfirmed' },
+    originalCommands: [command],
+    financialStatus: 'UNKNOWN',
+    acquisitions: 1,
+  });
+});
+
+it('shares one verified cleanup across concurrent close callers', async () => {
+  const gate = cleanupGate();
+  const f = await fixture(gate);
+  const first = observeClose(f.close());
+  const second = observeClose(f.close());
+  await gate.started;
+  gate.finish('verified');
+  expect(await Promise.all([first.result, second.result])).toEqual([
+    'fulfilled',
+    'fulfilled',
+  ]);
+  expect(f.cleanup()).toEqual({ attempts: 1, state: 'verified' });
+  expect(f.writes).toEqual([]);
+});
+
+it('keeps both callers pending while cleanup acknowledgment is pending', async () => {
+  const gate = cleanupGate();
+  const f = await fixture(gate);
+  const first = observeClose(f.close());
+  await gate.started;
+  const second = observeClose(f.close());
+  await setImmediate();
+  const pending = {
+    first: first.state(),
+    second: second.state(),
+    ...f.cleanup(),
+  };
+  gate.finish('verified');
+  await Promise.all([first.result, second.result]);
+  expect(pending).toEqual({
+    first: 'pending',
+    second: 'pending',
+    attempts: 1,
+    state: 'pending',
+  });
+});
+
+it('delivers a late cleanup rejection to both close callers', async () => {
+  const gate = cleanupGate();
+  const f = await fixture(gate);
+  const first = observeClose(f.close());
+  await gate.started;
+  const second = observeClose(f.close());
+  await setImmediate();
+  const secondBeforeRejection = second.state();
+  gate.finish('unconfirmed');
+  const results = await Promise.all([first.result, second.result]);
+  expect({ secondBeforeRejection, results, cleanup: f.cleanup() }).toEqual({
+    secondBeforeRejection: 'pending',
+    results: ['rejected', 'rejected'],
+    cleanup: { attempts: 1, state: 'unconfirmed' },
+  });
+});
+
+it('holds an ambiguous original command UNKNOWN without redispatch', async () => {
+  const f = await fixture();
+  const { command, invoiceId } = f.identity;
+  const different = randomUUID();
+  await expect(f.issuer.issue(command)).rejects.toThrow('UNKNOWN');
+  await expect(f.issuer.issue(command)).rejects.toThrow('UNKNOWN');
+  await expect(f.issuer.issue(different)).rejects.toThrow('UNKNOWN');
+  await expect(f.issuer.readOriginal(different)).rejects.toThrow('UNKNOWN');
+  const original = await f.issuer.readOriginal(command);
+  expect(original).toMatchObject({ invoiceId, issuanceReceiptId: command });
+  expect(f.issuer.status()).toBe('UNKNOWN');
+  expect(f.writes).toEqual([command]);
+  expect(f.receiptReads).toEqual([different, command, command]);
+  await f.close();
+  expect(f.issuer.status()).toBe('UNKNOWN');
+});
+
+it('inspects status and reconciles the original receipt without dispatching a writer', async () => {
+  const f = await fixture();
+  const { command, invoiceId } = f.identity;
+  await expect(f.issuer.issue(command)).rejects.toThrow('UNKNOWN');
+  const before = f.calls();
+  expect(f.issuer.status()).toBe('UNKNOWN');
+  expect(f.calls()).toEqual(before);
+  expect(await f.issuer.reconcile()).toMatchObject({
+    invoiceId,
+    issuanceReceiptId: command,
+    paymentState: 'unverified',
+  });
+  expect(f.writes).toEqual([command]);
+  expect(f.receiptReads).toEqual([command, command]);
+  expect(f.issuer.status()).toBe('CONFIRMED_ISSUANCE_ONLY');
+  await f.close();
+});
+
+it('keeps unknown cleanup and issuance held across authorization withdrawal', async () => {
+  const gate = cleanupGate();
+  const f = await fixture(gate);
+  const { command } = f.identity;
+  await expect(f.issuer.issue(command)).rejects.toThrow('UNKNOWN');
+  f.withdraw();
+  await expect(f.issuer.reconcile()).rejects.toThrow('UNKNOWN');
+  const first = observeClose(f.close());
+  await gate.started;
+  const second = observeClose(f.close());
+  gate.finish('unconfirmed');
+  const results = await Promise.all([first.result, second.result]);
+  expect({
+    results,
+    financialStatus: f.issuer.status(),
+    writes: f.writes,
+    receiptReads: f.receiptReads,
+  }).toEqual({
+    results: ['rejected', 'rejected'],
+    financialStatus: 'UNKNOWN',
+    writes: [command],
+    receiptReads: [],
+  });
+});
