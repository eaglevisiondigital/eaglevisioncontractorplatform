+    f.read(f.target, new AbortController().signal),
+  ).rejects.toThrow();
+});
+it.each([
+  'pending',
+  'unknown',
+  'declined',
+  'cancelled',
+  'disputed',
+  'settled',
+  'paid',
+])(
+  'unsupported/uncertain %s is withheld, never relabeled as a receipt',
+  async (kind) => {
+    const f = fixture();
+    f.query.mockResolvedValueOnce({
+      rows: [{ receipt: { ...f.value, kind } }],
