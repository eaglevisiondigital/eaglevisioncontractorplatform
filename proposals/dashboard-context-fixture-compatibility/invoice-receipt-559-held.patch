+      },
+      getOwnPropertyDescriptor() {
+        traps++;
+        throw Error('must not inspect');
+      },
+    },
+  );
+  const read = currentInvoicePaymentReceipt(
+    unsafe as never,
+    '',
+    unsafe as never,
+    unsafe as never,
+    unsafe as never,
+    unsafe as never,
+    unsafe as never,
+  );
+  await expect(read(unsafe as never, '', signal())).rejects.toThrow('UNKNOWN');
+  expect(traps).toBe(0);
+});
+
+it.each([
+  'issuanceReceiptReference',
+  'invoiceAmountMinor',
+  'invoiceId',
+  'customerId',
+  'locationId',
+] as const)(
+  'rejects mismatched receipt %s despite a currently readable invoice',
+  async (field) => {
+    const s = fixture();
+    if (field === 'invoiceAmountMinor') s.value[field]++;
+    else s.value[field] = randomUUID();
+    await expect(s.load()).rejects.toThrow('UNKNOWN');
+  },
+);
+
+it('the independent old receipt reader alone does not supply a current invoice/issuance join', async () => {
+  const s = fixture();
+  s.value.issuanceReceiptReference = randomUUID();
+  const old = restrictedPublicationRead(
+    s.connection,
+    new CommercialCallerConnection(
+      s.connection,
+      s.f.auth,
+      s.f.bearer,
+      s.receiptBackend,
+    ),
+    s.options,
+  );
+  const target = {
+    organizationId: s.value.organizationId,
+    customerId: s.value.customerId,
+    locationId: s.value.locationId,
+    invoiceId: s.value.invoiceId,
+    publicationId: s.publicationId,
+  };
+  expect((await old(target, signal())).issuanceReceiptReference).not.toBe(
+    s.f.scope.issuanceReceiptId,
+  );
+  await expect(s.load()).rejects.toThrow('UNKNOWN');
+});
+
+it.each([
+  'rolsuper',
+  'rolbypassrls',
+  'raw_table_access',
+  'other_definer',
+] as const)(
+  'a safe invoice does not confer financial reader authority when %s',
+  async (field) => {
+    const s = fixture();
+    s.profile[field] = true;
+    await expect(s.load()).rejects.toThrow('UNKNOWN');
+    expect(s.receiptCalls()).toBe(0);
+  },
+);
+
+it('a safe invoice does not confer receipt EXECUTE authority', async () => {
+  const s = fixture();
+  s.profile.receipt_execute = false;
+  await expect(s.load()).rejects.toThrow('UNKNOWN');
+  expect(s.receiptCalls()).toBe(0);
+});
+
+it.each(['database', 'login', 'backend'] as const)(
+  'requires a distinct same-target receipt principal/backend: %s',
+  async (field) => {
+    const s = fixture();
+    if (field === 'database') s.receiptBackend.database += '_foreign';
+    if (field === 'login') s.receiptBackend.login = s.f.inspect.login;
+    if (field === 'backend') {
+      s.receiptBackend.pid = s.f.inspect.pid;
+      s.receiptBackend.backend_start = s.f.inspect.backend_start;
+    }
+    await expect(s.load()).rejects.toThrow('UNKNOWN');
+    expect(s.receiptCalls()).toBe(0);
+  },
+);
+
+it('does not permit the same injected connection to serve both read authorities', async () => {
+  const s = fixture();
+  const read = currentInvoicePaymentReceipt(
+    s.f.auth,
+    s.f.bearer,
+    s.f.connection,
+    s.f.inspect,
+    s.f.scope,
+    s.f.connection,
+    s.receiptBackend,
+    s.options,
+  );
+  await expect(read(s.f.view, s.publicationId, signal())).rejects.toThrow(
+    'UNKNOWN',
+  );
+  expect(s.f.calls).toHaveLength(0);
+});
+
+it('suppresses late current Auth revocation after a receipt await', async () => {
+  const s = fixture();
+  s.hooks.afterReceipt = async () => s.f.setAuth(false);
+  await expect(s.load()).rejects.toThrow('UNKNOWN');
+});
+
+it('suppresses late invoice authority withdrawal', async () => {
+  const s = fixture();
+  s.hooks.afterReceipt = async () => s.f.revoke();
+  await expect(s.load()).rejects.toThrow('UNKNOWN');
+});
+
+it('suppresses changed private scope without exposing its hash', async () => {
+  const s = fixture();
+  s.hooks.afterReceipt = async () => {
+    s.f.scope.sourceHash = 'd'.repeat(64);
+  };
+  await expect(s.load()).rejects.toThrow('UNKNOWN');
+});
+
+it('withdrawal of explicit enablement during the receipt await denies', async () => {
+  const s = fixture();
+  s.hooks.afterReceipt = async () => {
+    s.options.enabled = false;
+  };
