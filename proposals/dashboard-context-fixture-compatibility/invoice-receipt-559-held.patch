+});
+
+it('changed immutable receipt contents across the two reads deny', async () => {
+  const s = fixture();
+  s.hooks.afterReceipt = async () => {
+    s.value.receiptReference = randomUUID();
+  };
+  await expect(s.load()).rejects.toThrow('UNKNOWN');
+});
+
+it('cancellation and the original five-second total deadline suppress late output', async () => {
+  const s = fixture(),
+    control = new AbortController();
+  s.hooks.afterReceipt = async () => control.abort();
+  await expect(s.load(control.signal)).rejects.toThrow('UNKNOWN');
+  const fresh = fixture();
