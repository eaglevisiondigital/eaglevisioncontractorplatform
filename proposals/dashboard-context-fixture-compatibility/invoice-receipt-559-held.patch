@@ -0,0 +1,267 @@
+import { isProxy } from 'node:util/types';
+import { CustomerBrokerAuth } from '../../server/customer/broker-auth';
+import {
+  CommercialCallerConnection,
+  type InvoiceConnectionScope,
+} from '../../server/invoices/commercial-caller-connection';
+import type { GatewaySql } from '../../server/payments/postgres-store';
+import {
+  readerScope,
+  type ReaderScope,
+} from '../commercial-customer-operating-reader/binding';
+import { operatingCustomerInvoiceRead } from '../commercial-customer-operating-reader/reader';
+import {
+  commercialCustomerTarget,
+  type CommercialCustomerTarget,
+} from '../../src/components/invoices/commercial-customer-read';
+import {
+  customerPaymentReceipt,
+  paymentPublicationTarget,
+  type CustomerPaymentReceipt,
+} from '../customer-payment-publication/contract';
+import { restrictedPublicationRead } from './read-only';
+
+const unavailable = () =>
+  Error('Current invoice payment receipt unavailable · UNKNOWN');
+const aborted = Object.getOwnPropertyDescriptor(
+  AbortSignal.prototype,
+  'aborted',
+)!.get!;
+const addEvent = EventTarget.prototype.addEventListener;
+const removeEvent = EventTarget.prototype.removeEventListener;
+
+function own(value: unknown, keys: readonly string[]) {
+  if (
+    !value ||
+    typeof value !== 'object' ||
+    isProxy(value) ||
+    ![null, Object.prototype].includes(Object.getPrototypeOf(value))
+  )
+    throw unavailable();
+  const descriptors = Object.getOwnPropertyDescriptors(value);
+  if (
+    Reflect.ownKeys(descriptors).length !== keys.length ||
+    keys.some((key) => !descriptors[key] || !('value' in descriptors[key]))
+  )
+    throw unavailable();
+  return Object.fromEntries(keys.map((key) => [key, descriptors[key].value]));
+}
+
+function settings(value: unknown) {
+  const row = own(value, ['enabled', 'mode']);
+  return row.enabled === true && row.mode === 'disposable-proposal';
+}
+
+function backend(value: InvoiceConnectionScope): InvoiceConnectionScope {
+  return own(value, [
+    'database',
+    'pid',
+    'backend_start',
+    'login',
+    'current_role',
+  ]) as unknown as InvoiceConnectionScope;
+}
+
+function target(value: CommercialCustomerTarget) {
+  const row = own(value, [
+    'invoice',
+    'companyName',
+    'customerName',
+    'propertyLabel',
+    'primaryColor',
+  ]);
+  own(row.invoice, [
+    'organizationId',
+    'customerId',
+    'locationId',
+    'invoiceId',
+    'sourceVersionId',
+    'revision',
+  ]);
+  return commercialCustomerTarget(row);
+}
+
+/** Default-OFF composition of the actual operating invoice reader and the
+ * existing restricted publication reader. Neither a DTO nor a supplied callback
+ * appoints a financial reader. No connection/Auth factory, query, grant, route,
+ * publisher, link, balance engine or financial command is introduced.
+ */
+export function currentInvoicePaymentReceipt(
+  auth: CustomerBrokerAuth,
+  bearer: string,
+  invoiceConnection: GatewaySql,
+  invoiceBackend: InvoiceConnectionScope,
+  invoiceScope: ReaderScope,
+  receiptConnection: GatewaySql,
+  receiptBackend: InvoiceConnectionScope,
+  options: { enabled: boolean; mode: 'disposable-proposal' } = {
+    enabled: false,
+    mode: 'disposable-proposal',
+  },
+) {
+  // OFF construction inspects no Auth, connection, backend, scope or target.
+  let enabled = false;
+  try {
+    enabled = settings(options);
+  } catch {
+    // Invalid settings are indistinguishable from unavailable authority.
+  }
+  let active = false,
+    closed = false;
+  return async (
+    input: CommercialCustomerTarget,
+    publicationId: string,
+    signal: AbortSignal,
+  ): Promise<Readonly<CustomerPaymentReceipt>> => {
+    let timer: ReturnType<typeof setTimeout> | undefined,
+      cancel: (() => void) | undefined;
+    const local = new AbortController();
+    let reserved = false;
+    try {
+      if (!enabled || !settings(options) || closed) throw unavailable();
+      if (active) {
+        closed = true;
+        throw unavailable();
+      }
+      if (
+        !(auth instanceof CustomerBrokerAuth) ||
+        isProxy(auth) ||
+        isProxy(invoiceConnection) ||
+        isProxy(receiptConnection) ||
+        invoiceConnection === receiptConnection ||
+        isProxy(signal) ||
+        aborted.call(signal)
+      )
+        throw unavailable();
+      active = reserved = true;
+      const scope = readerScope(invoiceScope),
+        invoiceOwner = backend(invoiceBackend),
+        receiptOwner = backend(receiptBackend),
+        selected = target(input),
+        publication = paymentPublicationTarget({
+          organizationId: selected.invoice.organizationId,
+          customerId: selected.invoice.customerId,
+          locationId: selected.invoice.locationId,
+          invoiceId: selected.invoice.invoiceId,
+          publicationId,
+        });
+      if (
+        invoiceOwner.database !== receiptOwner.database ||
+        invoiceOwner.login === receiptOwner.login ||
+        invoiceOwner.current_role === receiptOwner.current_role ||
+        (invoiceOwner.pid === receiptOwner.pid &&
+          invoiceOwner.backend_start === receiptOwner.backend_start)
+      )
+        throw unavailable();
+      const initial = JSON.stringify({
+        scope,
+        invoiceOwner,
+        receiptOwner,
+        selected,
+      });
+      const start = Date.now(),
+        deadline = start + 5000;
+      let last = start,
+        until = deadline;
+      cancel = () => local.abort();
+      Reflect.apply(addEvent, signal, ['abort', cancel, { once: true }]);
+      if (aborted.call(signal)) local.abort();
+      const check = () => {
+        const now = Date.now();
+        if (
+          closed ||
+          !settings(options) ||
+          aborted.call(signal) ||
+          local.signal.aborted ||
+          now < last ||
+          now >= until ||
+          JSON.stringify({
+            scope: readerScope(invoiceScope),
+            invoiceOwner: backend(invoiceBackend),
+            receiptOwner: backend(receiptBackend),
+            selected: target(input),
+          }) !== initial
+        )
+          throw unavailable();
+        last = now;
+      };
+      check();
+      const invoiceRead = operatingCustomerInvoiceRead(
+        auth,
+        bearer,
+        invoiceConnection,
+        invoiceOwner,
+        scope,
+        { enabled: true, mode: 'disposable-proposal' },
+      );
+      const receiptRead = restrictedPublicationRead(
+        receiptConnection,
+        new CommercialCallerConnection(
+          receiptConnection,
+          auth,
+          bearer,
+          receiptOwner,
+        ),
+        { enabled: true, mode: 'disposable-proposal' },
+      );
+      const work = async () => {
+        const first = await invoiceRead(selected, local.signal);
+        check();
+        until = Math.min(until, first.expiresAt);
+        const readReceipt = async () => {
+          check();
+          const value = await receiptRead(publication, local.signal);
+          check();
+          until = Math.min(until, value.expiresAt);
+          if (
+            value.issuanceReceiptReference !== scope.issuanceReceiptId ||
+            value.issuanceReceiptReference !==
+              first.invoice.issuanceReceiptId ||
+            value.invoiceAmountMinor !== first.invoice.amountMinor ||
+            value.currency !== first.invoice.currency
+          )
+            throw unavailable();
+          return value;
+        };
+        const receipt = await readReceipt();
+        const middle = await invoiceRead(selected, local.signal);
+        check();
+        until = Math.min(until, middle.expiresAt);
+        if (JSON.stringify(first.invoice) !== JSON.stringify(middle.invoice))
+          throw unavailable();
+        const second = await readReceipt();
+        const stable = (value: Readonly<CustomerPaymentReceipt>) =>
+          JSON.stringify({ ...value, observedAt: 0, expiresAt: 0 });
+        if (stable(receipt) !== stable(second)) throw unavailable();
+        const final = await invoiceRead(selected, local.signal);
+        check();
+        until = Math.min(until, final.expiresAt);
+        if (JSON.stringify(first.invoice) !== JSON.stringify(final.invoice))
+          throw unavailable();
+        check();
+        return customerPaymentReceipt(
+          { ...second, expiresAt: Math.min(second.expiresAt, until) },
+          publication,
+        );
+      };
+      const timeout = new Promise<never>((_, reject) => {
+        timer = setTimeout(
+          () => {
+            local.abort();
+            reject(unavailable());
+          },
+          Math.max(1, deadline - Date.now()),
+        );
+      });
+      return await Promise.race([work(), timeout]);
+    } catch {
+      if (reserved) closed = true;
+      throw unavailable();
+    } finally {
+      local.abort();
+      if (timer) clearTimeout(timer);
+      if (cancel) Reflect.apply(removeEvent, signal, ['abort', cancel]);
+      if (reserved) active = false;
+    }
+  };
+}
