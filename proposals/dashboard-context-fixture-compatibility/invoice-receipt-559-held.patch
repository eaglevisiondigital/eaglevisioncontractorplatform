+import { afterEach, expect, it, vi } from 'vitest';
+import { randomUUID } from 'node:crypto';
+import { operatingReaderModel } from './fixtures/operating-customer-reader';
+import { customerPaymentPublicationFixture } from './fixtures/customer-payment-publication';
+import { currentInvoicePaymentReceipt } from '../proposals/customer-publication-admission/invoice-read';
+import {
+  customerPublicationRoleQuery,
+  restrictedPublicationRead,
+} from '../proposals/customer-publication-admission/read-only';
+import { CommercialCallerConnection } from '../server/invoices/commercial-caller-connection';
+import type { GatewaySql } from '../server/payments/postgres-store';
+
+afterEach(() => vi.useRealTimers());
+const signal = () => new AbortController().signal;
+function fixture() {
+  const f = operatingReaderModel();
+  const publicationId = randomUUID();
+  const receiptBackend = {
+    ...f.inspect,
+    pid: f.inspect.pid + 1,
+    login: 'fixture_receipt_reader',
+    current_role: 'fixture_receipt_reader',
+  };
+  const profile = {
+    login: receiptBackend.login,
+    current_role: receiptBackend.current_role,
+    rolcanlogin: true,
+    rolsuper: false,
+    rolbypassrls: false,
+    rolcreatedb: false,
+    rolcreaterole: false,
+    rolreplication: false,
+    memberships: 0,
+    receipt_execute: true,
+    schema_usage: true,
+    schema_create: false,
+    raw_table_access: false,
+    other_definer: false,
+  };
+  const value = {
+    ...customerPaymentPublicationFixture().value,
+    organizationId: f.scope.organizationId,
+    customerId: f.scope.customerId,
+    locationId: f.scope.locationId,
+    invoiceId: f.scope.invoiceId,
+    publicationId,
+    issuanceReceiptReference: f.scope.issuanceReceiptId,
+    invoiceAmountMinor: f.value.invoice.amountMinor,
+    amountMinor: Math.min(4000, f.value.invoice.amountMinor),
+  };
+  const calls: string[] = [];
+  let receiptCalls = 0;
+  const hooks = { afterReceipt: async () => {}, hang: false };
+  const connection: GatewaySql = {
+    async query<T extends Record<string, unknown>>(
+      text: string,
+      params?: unknown[],
+    ) {
+      calls.push(text);
+      let rows: unknown[];
+      if (text.includes('from pg_stat_activity where pid=pg_backend_pid()'))
+        rows = [{ ...receiptBackend, claims: JSON.stringify(f.claims) }];
+      else if (text === customerPublicationRoleQuery) rows = [{ ...profile }];
+      else if (
+        text ===
+        'select private.customer_payment_receipt($1::uuid,$2::uuid,$3::uuid,$4::uuid,$5::uuid) receipt'
+      ) {
+        receiptCalls++;
+        expect(params).toEqual([
+          value.organizationId,
+          value.customerId,
+          value.locationId,
+          value.invoiceId,
+          value.publicationId,
+        ]);
+        if (hooks.hang) return new Promise(() => {});
+        const receipt = structuredClone({
+          ...value,
+          observedAt: Date.now(),
+          expiresAt: Date.now() + 30000,
+        });
+        await hooks.afterReceipt();
+        rows = [{ receipt }];
+      } else
+        throw Error(
+          'No command, alternate query or private table access permitted',
+        );
+      return { rows: rows as T[] };
+    },
+  };
+  const options = { enabled: true, mode: 'disposable-proposal' as const };
+  const read = currentInvoicePaymentReceipt(
+    f.auth,
+    f.bearer,
+    f.connection,
+    f.inspect,
+    f.scope,
+    connection,
+    receiptBackend,
+    options,
+  );
+  const load = (s = signal()) => read(f.view, publicationId, s);
+  return {
+    f,
+    value,
+    profile,
+    receiptBackend,
+    connection,
+    calls,
+    hooks,
+    options,
+    read,
+    load,
+    publicationId,
+    receiptCalls: () => receiptCalls,
+  };
+}
+
+it('factory-owned operating invoice and restricted receipt reads return only the original receipt contract', async () => {
+  const s = fixture();
