+      const s = lstatSync(p);
+      return String(p) === 'proposals/invoice-payment-receipt/qualification.ts'
+        ? new Proxy(s, {
+            get(t, k) {
+              if (k === 'isSymbolicLink' && kind === 'symlink')
+                return () => true;
+              if (k === 'mode' && kind === 'mode') return 0o755;
