# Browser-safe settings only. Never use service-role or provider secrets here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-only runtime settings (configure separately in Netlify Functions scope).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# No payment provider credentials are needed in Phase 1.
# Server-only public intake. Disabled until an approved test environment is ready.
PUBLIC_INTAKE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=
# Generate independent random secrets of at least 32 characters; never commit values.
# Store only the gateway key SHA-256 hash in private.intake_gateway_keys.
INTAKE_GATEWAY_KEY=
INTAKE_RATE_LIMIT_SECRET=
